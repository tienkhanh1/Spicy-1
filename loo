-- SAE comes in small cached parts (raw GitHub stalls on some networks), with a progress bar and a load trace sent to chillihub.pro
local function loadSAE()
    local REPO = "tienkhanh1/Chilli-Hub-Script"
    local RAW, CDN = "https://raw.githubusercontent.com/" .. REPO .. "/refs/heads/main/", "https://cdn.jsdelivr.net/gh/" .. REPO .. "@main/"
    local CACHE, TRACE, PROGRESS = "ChilliLibrary/HubCache", "ChilliLibrary/SAE_LoaderTrace.txt", "ChilliLibrary/SAE_LoadProgress.txt"
    local Http, UIS, lp = game:GetService("HttpService"), game:GetService("UserInputService"), game:GetService("Players").LocalPlayer
    local function try(f, ...) if type(f) ~= "function" then return end local ok, r = pcall(f, ...) if ok then return r end end
    local t0, sid, prev = os.clock(), Http:GenerateGUID(false):sub(1, 8), try(readfile, TRACE) or ""
    local exName, exVer = try(identifyexecutor)
    local req = request or http_request or (syn and syn.request) or (http and http.request)
    pcall(makefolder, "ChilliLibrary")
    local function report(st, extra)
        pcall(writefile, TRACE, st .. " " .. os.time())
        if type(req) ~= "function" then return end
        local b = { sid = sid, st = st, ms = math.floor((os.clock() - t0) * 1000), u = lp and lp.Name, ex = tostring(exName) .. " " .. tostring(exVer or ""), prev = prev, dev = UIS.TouchEnabled and "touch" or "pc" }
        for k, v in pairs(extra or {}) do b[k] = v end
        task.spawn(pcall, req, { Url = "https://chillihub.pro/api/lt", Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = Http:JSONEncode(b) })
    end

    -- same name and parent as the hub's own bar, so the hub replaces it when it starts
    local parent = game:GetService("CoreGui")
    pcall(function() local h = gethui() if typeof(h) == "Instance" then parent = h end end)
    local old = parent:FindFirstChild("ChilliHubLoading")
    if old then old:Destroy() end
    local gui = Instance.new("ScreenGui")
    gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset, gui.DisplayOrder = "ChilliHubLoading", false, true, 1000
    local frame = Instance.new("Frame")
    frame.AnchorPoint, frame.Position, frame.Size = Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 24), UDim2.fromOffset(260, 64)
    frame.BackgroundColor3, frame.BackgroundTransparency, frame.Parent = Color3.fromRGB(18, 18, 22), 0.05, gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color, stroke.Thickness, stroke.Transparency = Color3.fromRGB(255, 60, 60), 1.5, 0.2
    local function label(y, h, font, size, color, align, text)
        local l = Instance.new("TextLabel")
        l.BackgroundTransparency, l.Position, l.Size = 1, UDim2.fromOffset(12, y), UDim2.new(1, -24, 0, h)
        l.Font, l.TextSize, l.TextColor3, l.TextXAlignment, l.Text, l.Parent = font, size, color, align, text, frame
        return l
    end
    label(8, 18, Enum.Font.GothamBold, 15, Color3.fromRGB(255, 255, 255), Enum.TextXAlignment.Left, "Chilli Hub")
    local percent = label(8, 18, Enum.Font.GothamBold, 15, Color3.fromRGB(255, 120, 90), Enum.TextXAlignment.Right, "0%")
    local detail = label(27, 14, Enum.Font.GothamMedium, 12, Color3.fromRGB(170, 170, 185), Enum.TextXAlignment.Left, "Checking version")
    local track = Instance.new("Frame")
    track.Position, track.Size, track.BackgroundColor3, track.Parent = UDim2.fromOffset(12, 46), UDim2.new(1, -24, 0, 8), Color3.fromRGB(42, 42, 50), frame
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame")
    fill.Size, fill.BackgroundColor3, fill.Parent = UDim2.new(0, 0, 1, 0), Color3.new(1, 1, 1), track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    Instance.new("UIGradient", fill).Color = ColorSequence.new(Color3.fromRGB(255, 50, 50), Color3.fromRGB(255, 150, 60))
    gui.Parent = parent
    local function bar(p, text)
        fill.Size, percent.Text, detail.Text = UDim2.new(p, 0, 1, 0), math.floor(p * 100) .. "%", text
        task.wait()
    end

    report("start")
    bar(0.02, "Checking version")
    -- manifest "<version> <bytes> <parts>" from raw first (fresh), parts from the CDN first (names never change)
    local function get(path, first, check)
        local order = first == "cdn" and { CDN, RAW } or { RAW, CDN }
        for _ = 1, 2 do
            for i, base in ipairs(order) do
                local ok, s = pcall(game.HttpGet, game, base .. path)
                if ok and type(s) == "string" and s ~= "" and (not check or check(s)) then return s, base == CDN and "cdn" or "raw" end
                task.wait(0.3)
            end
        end
    end
    local man = get("SAE/manifest?t=" .. os.time(), "raw", function(s) return s:match("^%S+ %d+ %d+") end)
    if not man then report("manifest_fail") gui:Destroy() return false end
    local ver, size, n = man:match("^(%S+) (%d+) (%d+)")
    size, n = tonumber(size), tonumber(n)
    local file = CACHE .. "/SAE_" .. ver .. ".lua"
    local src = try(readfile, file)
    if src and #src == size then
        report("cache", { v = ver })
    else
        local parts = {}
        for i = 1, n do
            bar(0.05 + 0.85 * (i - 1) / n, ("Downloading %d / %d"):format(i, n))
            local s, from = get(("SAE/%s-%d"):format(ver, i), "cdn")
            if not s then report("part_fail", { v = ver, n = i }) gui:Destroy() return false end
            parts[i] = s
            report("part", { v = ver, n = i, src = from })
        end
        src = table.concat(parts)
        if #src ~= size then report("size_bad", { v = ver, n = #src }) gui:Destroy() return false end
        pcall(makefolder, CACHE)
        for _, f in ipairs(try(listfiles, CACHE) or {}) do if f:match("SAE_.+%.lua$") then pcall(delfile, f) end end
        pcall(writefile, file, src)
    end
    bar(0.95, "Starting")
    local fn, err = loadstring(src)
    if not fn then report("compile_fail", { v = ver, err = tostring(err) }) gui:Destroy() return false end
    report("compiled", { v = ver })
    -- the hub writes its step (0..10) to SAE_LoadProgress.txt; pass each new step on while it loads
    task.spawn(function()
        local last
        for _ = 1, 240 do
            task.wait(0.5)
            local s = (try(readfile, PROGRESS) or ""):match("^(%d+)")
            if s and s ~= last then last = s report(s == "10" and "done" or "step" .. s, { v = ver }) end
            if s == "10" then return end
        end
        report("timeout", { v = ver, n = last })
    end)
    local ok, e = pcall(fn)
    if not ok then report("run_fail", { v = ver, err = tostring(e) }) end
    return true
end

if url == SAE then
    local ok, done = pcall(loadSAE)
    if ok and done then
        return
    end
end

for _ = 1, 3 do
    local ok, source = pcall(game.HttpGet, game, url)
    if ok and type(source) == "string" and source ~= "" then
        local chunk = loadstring(source)
        if chunk then
            chunk()
        end
        return
    end
    task.wait(0.5)
end
